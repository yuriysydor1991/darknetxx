FROM jenkins/jenkins:lts

USER root 

RUN apt update
RUN apt install -y libstdc++6 build-essential git cmake g++
# the OpenCV is the mandatory dependency of the project
RUN apt install -y libopencv-dev
# the dxxwjz1 network weights files are the gzip compressed JSON documents
RUN apt install -y zlib1g-dev nlohmann-json3-dev
# the GTK 4 toolkit of the GUI binaries
RUN apt install -y libgtkmm-4.0-dev

# The network weights files and the training projects formats come from the
# darknetxx-datadrivers library, which is no distribution package: it is built
# of it's sources and installed into the prefix, where the configure of the
# project below finds it (and the binaries of the project at the run time).
RUN git clone --depth 1 --branch ${DARKNETXX_DXXDD_GIT_TAG} ${DARKNETXX_DXXDD_GIT} /src/darknetxx-datadrivers && \
 cmake -S /src/darknetxx-datadrivers -B /src/darknetxx-datadrivers-build \
   -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr && \
 cmake --build /src/darknetxx-datadrivers-build -j$(nproc) && \
 cmake --install /src/darknetxx-datadrivers-build && \
 ldconfig

# the misc/.clang-format style needs the clang-format 16 or newer
RUN apt install -y clang-format && \
 (clang-format --version | grep -Eq 'version (1[6-9]|[2-9][0-9])\.' || \
  apt install -y clang-format-16)
RUN apt install -y cppcheck
RUN apt install -y valgrind
RUN apt install -y flatpak
RUN apt install -y clang-tidy
RUN apt install -y libgtest-dev
RUN apt install -y libgmock-dev

CMD ["jenkins.sh"]

