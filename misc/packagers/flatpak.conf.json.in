{
  "id": "${FLATPAK_PROJECT_URL}",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "${FLATPAK_COMMAND}",
  "modules": [
    {
      "name": "opencv",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_LIST=core,imgproc,imgcodecs,highgui,videoio",
        "-DBUILD_TESTS=OFF",
        "-DBUILD_PERF_TESTS=OFF",
        "-DBUILD_EXAMPLES=OFF",
        "-DBUILD_opencv_apps=OFF",
        "-DBUILD_JAVA=OFF",
        "-DBUILD_opencv_python3=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/opencv/opencv.git",
          "tag": "4.10.0"
        }
      ]
    },
    {
      "name": "nlohmann-json",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DJSON_BuildTests=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "${DARKNETXX_NLOHMANN_GIT}",
          "tag": "${DARKNETXX_NLOHMANN_GIT_TAG}"
        }
      ]
    },
    {
      "name": "mm-common",
      "buildsystem": "meson",
      "config-opts": [
        "-Duse-network=true"
      ],
      "build-options": {
        "build-args": [ "--share=network" ]
      },
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/mm-common.git",
          "tag": "1.0.8"
        }
      ]
    },
    {
      "name": "gtkmm",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuild-documentation=false",
        "-Dbuild-demos=false",
        "-Dbuild-tests=false"
      ],
      "build-options": {
        "build-args": [ "--share=network" ]
      },
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gtkmm.git",
          "tag": "4.24.0"
        }
      ]
    },
    {
      "name": "${PROJECT_NAME}",
      "buildsystem": "cmake",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_SSE_AND_AVX_FLAGS=OFF"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "${PROJECT_SOURCE_DIR}"
        }
      ]
    }
  ],
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home"
  ]
}
