name: ${PROJECT_BINARY_NAME_lower}
base: core24
version: '${CMAKE_PROJECT_VERSION}'
summary: ${CMAKE_PROJECT_DESCRIPTION}
description: |
  ${CMAKE_PROJECT_DESCRIPTION}

grade: ${TEMPLATE_PROJECT_SNAP_GRADE}
confinement: ${TEMPLATE_PROJECT_SNAP_CONFINEMENT}

apps:
  ${PROJECT_BINARY_NAME}:
    command: usr/${PROJECT_BINARY_INSTALLATION_DIR}/${PROJECT_BINARY_NAME}
    plugs:
      - home

parts:
  ${PROJECT_BINARY_NAME}:
    plugin: cmake
    source: '${CMAKE_SOURCE_DIR}'
    cmake-generator: '${CMAKE_GENERATOR}'
    cmake-parameters:
      - -DCMAKE_BUILD_TYPE=Release
      # the snap command above expects the binary under the usr of the snap
      - -DCMAKE_INSTALL_PREFIX=/usr
      # the package runs on other machines, which may lack the AVX2 and FMA
      - -DENABLE_SSE_AND_AVX_FLAGS=OFF
    build-packages:
      - libopencv-dev
      # the dxxwjz1 network weights files are the gzip compressed JSON
      # documents
      - zlib1g-dev
      - nlohmann-json3-dev
    # the runtime libraries the project links with: the OpenMP, the zlib and
    # the OpenCV modules
    stage-packages:
      - libgomp1
      - zlib1g
      - libopencv-core406t64
      - libopencv-imgproc406t64
      - libopencv-imgcodecs406t64
      - libopencv-highgui406t64
      - libopencv-videoio406t64
