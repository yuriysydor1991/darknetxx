name: ${DARKNETXX_BINARY_NAME_lower}
base: core24
version: '${PROJECT_VERSION}'
summary: ${PROJECT_DESCRIPTION}
description: |
  ${PROJECT_DESCRIPTION}

grade: ${DARKNETXX_SNAP_GRADE}
confinement: ${DARKNETXX_SNAP_CONFINEMENT}

apps:
  ${DARKNETXX_BINARY_NAME}:
    command: usr/${DARKNETXX_BINARY_INSTALLATION_DIR}/${DARKNETXX_BINARY_NAME}
    plugs:
      - home
${DARKNETXX_SNAP_CONVERTER_APP}
${DARKNETXX_SNAP_GUI_APP}
parts:
  ${DARKNETXX_BINARY_NAME}:
    plugin: cmake
    source: '${PROJECT_SOURCE_DIR}'
    cmake-generator: '${CMAKE_GENERATOR}'
    cmake-parameters:
      - -DCMAKE_BUILD_TYPE=Release
      # the snap command above expects the binary under the usr of the snap
      - -DCMAKE_INSTALL_PREFIX=/usr
      # the package runs on other machines, which may lack the AVX2 and FMA
      - -DENABLE_SSE_AND_AVX_FLAGS=OFF
      # the converter binary the apps above name (or not)
      - -DENABLE_DARKNETXX_CONVERTER=${ENABLE_DARKNETXX_CONVERTER}
      # the GUI binary the apps above name (or not)
      - -DENABLE_DARKNETXX_GUI=${ENABLE_DARKNETXX_GUI}
    build-packages:
      - libopencv-dev
      # the dxxwjz1 network weights files are the gzip compressed JSON
      # documents
      - zlib1g-dev
      - nlohmann-json3-dev
${DARKNETXX_SNAP_GUI_BUILD_PACKAGE}
    # the runtime libraries the project links with: the OpenMP, the zlib and
    # the OpenCV modules
    stage-packages:
      - libgomp1
      - zlib1g
      - libopencv-core406t64
      - libopencv-imgproc406t64
      - libopencv-imgcodecs406t64
      - libopencv-highgui406t64
      - libopencv-videoio406t64
${DARKNETXX_SNAP_GUI_STAGE_PACKAGE}
