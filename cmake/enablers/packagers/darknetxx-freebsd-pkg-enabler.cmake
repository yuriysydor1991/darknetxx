cmake_minimum_required(VERSION 3.13)

option(
  ENABLE_FREEBSD_PKG
  "Set to ON to enable the FreeBSD pkg package creation from the project build artifacts"
  OFF
)

if(NOT ENABLE_FREEBSD_PKG)
    return()
endif()

include(InstallRequiredSystemLibraries)

set(
  DARKNETXX_FREEBSD_PKG_LICENSE
  "BSD2CLAUSE"
  CACHE STRING
  "FreeBSD pkg license tag (e.g. BSD2CLAUSE, BSD3CLAUSE, GPLv3, MIT)"
)

set(
  DARKNETXX_FREEBSD_PKG_ORIGIN
  "misc/${DARKNETXX_BINARY_NAME_lower}"
  CACHE STRING
  "FreeBSD pkg origin in <category>/<name> form"
)

set(
  DARKNETXX_FREEBSD_PKG_CATEGORIES
  "misc"
  CACHE STRING
  "Semicolon-separated list of FreeBSD pkg categories"
)

set(CPACK_GENERATOR "FREEBSD")
set(CPACK_PACKAGE_NAME ${PROJECT_NAME})
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_CONTACT ${DARKNETXX_MAINTAINER_EMAIL})
set(CPACK_PACKAGE_VENDOR "${DARKNETXX_MAINTAINER}")
set(CPACK_PACKAGE_DESCRIPTION ${PROJECT_DESCRIPTION})
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY ${PROJECT_DESCRIPTION})

set(CPACK_FREEBSD_PACKAGE_NAME ${PROJECT_NAME})
set(CPACK_FREEBSD_PACKAGE_COMMENT ${PROJECT_DESCRIPTION})
set(CPACK_FREEBSD_PACKAGE_DESCRIPTION ${PROJECT_DESCRIPTION})
set(CPACK_FREEBSD_PACKAGE_WWW ${PROJECT_HOMEPAGE_URL})
set(CPACK_FREEBSD_PACKAGE_LICENSE ${DARKNETXX_FREEBSD_PKG_LICENSE})
set(CPACK_FREEBSD_PACKAGE_MAINTAINER "${DARKNETXX_MAINTAINER_EMAIL}")
set(CPACK_FREEBSD_PACKAGE_ORIGIN ${DARKNETXX_FREEBSD_PKG_ORIGIN})
set(CPACK_FREEBSD_PACKAGE_CATEGORIES ${DARKNETXX_FREEBSD_PKG_CATEGORIES})
set(CPACK_FREEBSD_PACKAGE_DEPS "")

include(CPack)
