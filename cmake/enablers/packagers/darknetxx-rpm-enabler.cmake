cmake_minimum_required(VERSION 3.13)

option(
  ENABLE_RPM
  "Set to ON to enable the RPM package creation from the project build artifacts"
  OFF
)

if(NOT ENABLE_RPM)
    return()
endif()

include(InstallRequiredSystemLibraries)

set(
  DARKNETXX_RPM_LICENSE
  "BSD-2-Clause"
  CACHE STRING
  "RPM package license tag (e.g. BSD-2-Clause, BSD-3-Clause, GPLv3, MIT, Apache-2.0)"
)

set(
  DARKNETXX_RPM_GROUP
  "Applications/System"
  CACHE STRING
  "RPM package group (e.g. Applications/System, Development/Libraries)"
)

set(
  DARKNETXX_RPM_RELEASE
  "1"
  CACHE STRING
  "RPM package release number (incremented across rebuilds of the same upstream version)"
)

set(
  DARKNETXX_RPM_PACKAGE_ARCHITECTURE
  "x86_64"
  CACHE STRING
  "RPM package architecture tag (e.g. x86_64, aarch64, noarch)"
)

set(CPACK_GENERATOR "RPM")
set(CPACK_PACKAGE_NAME ${PROJECT_NAME})
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_CONTACT ${DARKNETXX_MAINTAINER_EMAIL})
set(CPACK_PACKAGE_VENDOR "${DARKNETXX_MAINTAINER}")
set(CPACK_PACKAGE_DESCRIPTION ${PROJECT_DESCRIPTION})
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY ${PROJECT_DESCRIPTION})

set(CPACK_RPM_PACKAGE_NAME ${PROJECT_NAME})
set(CPACK_RPM_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_RPM_PACKAGE_LICENSE ${DARKNETXX_RPM_LICENSE})
set(CPACK_RPM_PACKAGE_GROUP ${DARKNETXX_RPM_GROUP})
set(CPACK_RPM_PACKAGE_RELEASE ${DARKNETXX_RPM_RELEASE})
set(CPACK_RPM_PACKAGE_URL ${PROJECT_HOMEPAGE_URL})
set(CPACK_RPM_PACKAGE_SUMMARY ${PROJECT_DESCRIPTION})
set(CPACK_RPM_PACKAGE_DESCRIPTION ${PROJECT_DESCRIPTION})
set(CPACK_RPM_PACKAGE_VENDOR "${DARKNETXX_MAINTAINER}")
set(CPACK_RPM_PACKAGE_ARCHITECTURE ${DARKNETXX_RPM_PACKAGE_ARCHITECTURE})
set(CPACK_RPM_PACKAGE_REQUIRES "")
set(CPACK_RPM_COMPONENT_INSTALL ON)

include(CPack)
