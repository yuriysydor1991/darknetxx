#ifndef YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H
#define YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H

#include <string>

/// @brief Global declaration for the project by CMake variables
namespace project_decls {

/// @brief Global project' binary name
const std::string PROJECT_NAME = "${DARKNETXX_BINARY_NAME}" ;
/// @brief Global project' network weights files converter only binary name
const std::string PROJECT_CONVERTER_NAME = "${DARKNETXX_CONVERTER_BINARY_NAME}" ;
/// @brief Global project' GUI training binary name
const std::string PROJECT_TRAIN_GUI_NAME = "${DARKNETXX_TRAIN_GUI_BINARY_NAME}" ;
/// @brief Global project' GUI recognition binary name
const std::string PROJECT_RECOGNITION_GUI_NAME = "${DARKNETXX_RECOGNITION_GUI_BINARY_NAME}" ;
/// @brief Global project' GTKmm 4 network editor binary name
const std::string PROJECT_NET_EDITOR_GUI_NAME = "${DARKNETXX_NET_EDITOR_GUI_BINARY_NAME}" ;
/// @brief Global project' GUI training application id
const std::string PROJECT_APPLICATION_ID = "${DARKNETXX_APPLICATION_ID}" ;
/// @brief Global project' GUI recognition application id
const std::string PROJECT_RECOGNITION_APPLICATION_ID = "${DARKNETXX_RECOGNITION_APPLICATION_ID}" ;
/// @brief Global project' GTKmm 4 network editor application id
const std::string PROJECT_NET_EDITOR_APPLICATION_ID = "${DARKNETXX_NET_EDITOR_APPLICATION_ID}" ;
/// @brief Global project' build version
const std::string PROJECT_BUILD_VERSION = "${PROJECT_VERSION}" ;
/// @brief Global project' configure git commit hash
const std::string PROJECT_BUILD_COMMIT = "${PROJECT_GIT_COMMIT}" ;
/// @brief Global project' CMake configure date
const std::string PROJECT_CONFIGURE_DATE = "${PROJECT_CONFIGURE_DATE}" ;

} // namespace project_decls

#endif // YOUR_CPP_APP_TEMPLATE_PROJECT_GLOBAL_DECLS_H
