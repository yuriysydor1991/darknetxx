#ifndef DARKNETXX_PROJECT_ITEST_DIGITS_DATA_PROVIDER_CLASS_H
#define DARKNETXX_PROJECT_ITEST_DIGITS_DATA_PROVIDER_CLASS_H

class ITEST_digits_provider
{
 public:
  // the executable path is known at the build time only
  inline static constexpr const char* const DARKNETXX = ITEST_DIGITS_DARKNETXX;

  inline static constexpr const char* const CFG = "@ITEST_DIGITS_CFG@";
  inline static constexpr const char* const WEIGHTS = "@ITEST_DIGITS_WEIGHTS@";

  // the digit_<digit>_<size>.png images of the training data set
  inline static constexpr const char* const DATA_DIR = "@ITEST_DIGITS_DATA_DIR@";
  inline static constexpr const int GLYPH_SIZES = @ITEST_DIGITS_GLYPH_SIZES@;

  // the working directories of the detection runs
  inline static constexpr const char* const DETECTIONS_DIR = "@ITEST_DIGITS_DETECTIONS_DIR@";

  // the working directory of the training, it's chart included
  inline static constexpr const char* const TRAINING_DIR = "@ITEST_DIGITS_TRAINING_DIR@";

  // the root of the working directories of the further trainings
  inline static constexpr const char* const RESUMED_DIR = "@ITEST_DIGITS_RESUMED_DIR@";

  inline static constexpr const char* const NAMES = "@ITEST_DIGITS_NAMES@";

  // the list of the training images, which the mAP calculation validates too
  inline static constexpr const char* const TRAIN_LIST = "@ITEST_DIGITS_TRAIN_LIST@";
};

#endif  // DARKNETXX_PROJECT_ITEST_DIGITS_DATA_PROVIDER_CLASS_H
